# MongoDB Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas cluster credentials:
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-url>/aptitude_db?retryWrites=true&w=majority"

# (Alternative) If using a Local MongoDB Replica Set:
# DATABASE_URL="mongodb://localhost:27017/aptitude_db?replicaSet=rs0&directConnection=true"

# JWT Secret for Admin Session Cookies
JWT_SECRET="aptitude-assessment-executive-secret-key-2026-secure"

# Default Admin Credentials for Seeding
ADMIN_DEFAULT_EMAIL="admin@aptitude.com"
ADMIN_DEFAULT_PASSWORD="Admin@1234"
